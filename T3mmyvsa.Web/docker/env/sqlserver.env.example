COMPOSE_PROFILES=sqlserver
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}
ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Release

DATABASE_PROVIDER=sqlserver
MSSQL_SA_PASSWORD=
SQLSERVER_PORT=1433
DATABASE_CONNECTION_STRING=Server=sqlserver,1433;Database=appdb;User Id=sa;Password=${MSSQL_SA_PASSWORD};Encrypt=True;TrustServerCertificate=True

JWT_SECRET=
HANGFIRE_ENABLED=true
HANGFIRE_SERVER_ENABLED=false
HANGFIRE_STORAGE_PROVIDER=inherit
HANGFIRE_CONNECTION_STRING_NAME=
HANGFIRE_CONNECTION_STRING=

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_PASSWORD=
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SECONDS=2
