COMPOSE_PROFILES=mysql
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}
ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Release

DATABASE_PROVIDER=mysql
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
DATABASE_CONNECTION_STRING=Server=mysql;Port=3306;Database=${MYSQL_DATABASE};User=${MYSQL_USER};Password=${MYSQL_PASSWORD}

JWT_SECRET=
# Hangfire supports SQL Server/PostgreSQL storage only in this starter.
HANGFIRE_ENABLED=false
HANGFIRE_SERVER_ENABLED=false
HANGFIRE_STORAGE_PROVIDER=inherit
HANGFIRE_CONNECTION_STRING_NAME=
HANGFIRE_CONNECTION_STRING=

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_PASSWORD=
MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SECONDS=2
