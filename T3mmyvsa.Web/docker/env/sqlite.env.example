# SQLite needs no Compose database profile; only api + migrate run.
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}
ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Release

DATABASE_PROVIDER=sqlite
DATABASE_CONNECTION_STRING=Data Source=/app/data/app.db

JWT_SECRET=
# Hangfire supports SQL Server/PostgreSQL storage only in this starter.
HANGFIRE_ENABLED=false
HANGFIRE_SERVER_ENABLED=false
HANGFIRE_STORAGE_PROVIDER=inherit
HANGFIRE_CONNECTION_STRING_NAME=
HANGFIRE_CONNECTION_STRING=

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_PASSWORD=
MIGRATION_MAX_ATTEMPTS=5
MIGRATION_RETRY_DELAY_SECONDS=1
