{
  "$schema": "http://json.schemastore.org/template",
  "author": "T3mmy",
  "classifications": [
    "Web",
    "API"
  ],
  "identity": "T3mmy.VSA.Template",
  "name": "T3mmyVSA",
  "description": "A production-oriented ASP.NET Core 10 Vertical Slice Architecture starter with Identity, permissions, multi-provider EF Core persistence, dedicated migrations and Hangfire worker processes, xUnit v3/MTP testing, Docker, health checks, and hardened defaults.",
  "shortName": "t3mmyvsa",
  "sourceName": "T3mmyvsa",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            ".git/**",
            "**/.git/**",
            "**/.idea/**",
            "**/.vscode/**",
            "logs/**",
            "**/*.user",
            "RULES.md",
            "Migrations/Data/Migrations/**"
          ],
          "rename": {
            ".github/workflows/_deploy-smarteraspnet.yml": ".github/workflows/deploy-smarteraspnet.yml"
          }
        }
      ]
    }
  ]
}
