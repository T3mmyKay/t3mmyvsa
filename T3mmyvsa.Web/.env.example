# PostgreSQL is the default Docker development profile.
# Copy this file to .env, replace the blank secrets, then run: docker compose up --build
COMPOSE_PROFILES=postgres
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}
ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Release

DATABASE_PROVIDER=postgresql
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

JWT_SECRET=

HANGFIRE_ENABLED=true
HANGFIRE_SERVER_ENABLED=true
HANGFIRE_STORAGE_PROVIDER=inherit
HANGFIRE_CONNECTION_STRING_NAME=
HANGFIRE_CONNECTION_STRING=

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_PASSWORD=

MIGRATION_MAX_ATTEMPTS=30
MIGRATION_RETRY_DELAY_SECONDS=2
