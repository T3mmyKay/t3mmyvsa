{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "DatabaseSettings": {
    "DBProvider": "mssql"
  },
  "JwtSettings": {
    "ValidIssuer": "T3mmyvsa-API",
    "ValidAudience": "T3mmyvsa-Client",
    "TokenValidityInMinutes": 15,
    "RefreshTokenValidityInDays": 7
  },
  "AppSettings": {
    "AppUrl": "https://localhost:5001"
  },
  "MailSettings": {
    "Mail": "no-reply@example.com",
    "DisplayName": "Support",
    "Host": "smtp.example.com",
    "Port": 587
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "FirstName": "System",
    "LastName": "Administrator"
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Authorization", "Content-Type", "Accept", "X-Api-Version"],
    "AllowCredentials": false,
    "PreflightMaxAgeSeconds": 600
  },
  "Proxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Registration": { "PermitLimit": 5, "WindowSeconds": 600 },
    "Recovery": { "PermitLimit": 5, "WindowSeconds": 900 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Hangfire": {
    "Enabled": true,
    "ServerEnabled": true,
    "ConnectionStringName": "sqlConnection",
    "SchemaName": "HangFire",
    "Queues": ["critical", "default"],
    "AutomaticRetryAttempts": 3,
    "PrepareSchemaIfNecessary": true,
    "Dashboard": {
      "Enabled": false,
      "Path": "/jobs",
      "RequireHttps": true,
      "ReadOnly": true,
      "AllowedIpAddresses": []
    }
  },
  "ApiDocumentation": {
    "Enabled": false
  }
}
